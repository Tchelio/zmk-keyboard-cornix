# Custom modules provided by this zmk-config repo, built as a Zephyr module.

config ZMK_LAYER_MARKER
    bool "Layer-change marker for host-side overlay detection"
    default n
    depends on !ZMK_SPLIT || (ZMK_SPLIT && ZMK_SPLIT_ROLE_CENTRAL)
    help
      Listens for ZMK's own layer_state_changed event (fired by every
      layer-referencing behavior: &mo, &lt, &tog, &to, &sl) and emits an
      unused F-key (F17/F18/F19/F13) as an invisible marker whenever a
      layer is activated. ZMK Studio's RPC exposes no layer-state
      notification at all, so this is the only way for a host-side overlay
      to detect which layer is currently active.

      Disabled by default (2026-08-28): the marker is a real HID keystroke,
      so any app with focus - not just the overlay - receives it too. macOS
      terminals decode F13+ as an ESC[NN~ escape sequence, and this was
      confirmed to corrupt raw (unechoed) reads like sudo's password prompt
      - not just cosmetic tilde leakage, actual auth failures, reproduced
      with every marker layer (F17/F18/F13), not just one. Turning this back
      on requires the CGEventTap-side interception in overlay-app's
      spawn_listener to be fully reliable first (it wasn't: permission
      registration, macOS's own tap-auto-disable, and shell raw-read vs.
      line-editor differences all separately defeated it in testing). See
      keyboard-restore-레이어마커-전역리스너 in the vault for the full history.
