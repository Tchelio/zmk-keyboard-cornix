// NOTE(2026-08-22): 이전에 있던 urob 스타일 홈로우모드 커스텀 설정은 폐기하고, 실제 RMK로 쓰던
// 키보드를 그대로 이식한 상태로 새로 시작함. 원래 커스텀 파일은 backup/cornix.keymap.urob-homerowmods-20260822에,
// ZMK 저장소 자체 예시 기본값은 backup/cornix.keymap.zmk-community-stock-example에 보존해둠(참고용).
// 실측 근거: raw/keyboard/work/실측-RMK실제레이아웃-vial스크린샷-20260822.md (Vial 스크린샷 판독)
//
// 확인된 것만 이식함:
//   - Layer 0(Base): 실제 RMK 그대로. 유일하게 스톡과 다른 지점은 우측 하단열의 Up(원래 / 자리) — 의도적 커스텀.
//   - Layer 1: 상단열(Esc+숫자기호)만 확인됨, 나머지 행은 실기기에서 비어있어서 &trans로 둠.
//   - Layer 2/3/4: BT 프로필 선택(공장 기본값, 사용자 확인함) — 왼손 상단열에 BT_SEL 0/1/2, 나머지 &trans.
//   - 키1(화살표/물음표): mod-morph로 구현 — 아래 behaviors 참고.
//   - 키2(슬래시/우쉬프트): 우하단 팜 Right(화살표) 바로 위, 원래 RShift였던 자리를 mod-tap으로 재활용 —
//     탭=`/`, 홀드=RSFT. ZMK 내장 &mt 그대로 사용(커스텀 behavior 불필요).

#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// NOTE(2026-09-05): stock &lt는 flavor="tap-preferred"라 홀드로 인정받으려면 200ms를 꽉
// 채워야 함(다른 키를 먼저 눌러도 탭으로 처리됨). &mt와 정의가 완전히 같고 flavor 한 줄만
// 다르므로, 커스텀 hold-tap을 새로 만들지 않고 stock 노드의 프로퍼티만 덮어씀. 이렇게 하면
// 키맵에는 그냥 `&lt`로 남아서 키맵에디터도 표준 behavior로 정상 인식함.
// 한영 치고 바로 다음 글자를 때렸을 때 홀드로 오인되면 "balanced"로 바꿀 것.

&lt { flavor = "hold-preferred"; };

/ {
    behaviors {
        // 키1: 탭=Up(화살표), 우쉬프트(키2 홀드)+탭='?', 좌쉬프트+탭=조건 불일치라 그냥 Shift+Up 통과(드래그/선택)
        // NOTE(2026-08-22 정정): 처음엔 좌쉬프트를 '?' 트리거로 넣었으나 실사용해보니 반대였음 — 우쉬프트로 수정.

        key1_arrow_qmark: key1_arrow_qmark {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&kp QUESTION>;

            mods = <(MOD_RSFT)>;
        };

        // NOTE(2026-08-22): &msc는 sensor-bindings(인코더)에 직접 못 씀 — #sensor-binding-cells가
        // 없어서 "lacks #sensor-binding-cells" devicetree 에러로 빌드가 깨짐(실사용 확인). 공식 문서의
        // zmk,behavior-sensor-rotate 패턴으로 감싸야 함.
        // NOTE(2026-08-22 추가): 빌드는 됐는데 스크롤이 전혀 안 먹는 문제 발생 — 실제 소스
        // (behavior_input_two_axis.c, behavior_sensor_rotate_common.c) 확인 결과, sensor-rotate
        // 기본 tap_ms=5가 msc의 trigger_period_ms=16보다 짧아서 첫 HID 리포트가 예약되기 전에
        // release로 취소되어 아예 안 나가는 게 원인. tap-ms를 16ms보다 길게 줘서 1차 수정.
        // NOTE(2026-08-22 추가 — tap-ms만으론 여전히 안 먹음): update_movement_1d/track_remainder
        // 계산까지 추적 — 기본 SCRL_UP(=10) 기준 tick 1회(16ms)당 이동량은 10*16/1000=0.16, 정수
        // 캐스팅되면서 0으로 버려짐. 여러 tick이 누적(약 7회=112ms)돼야 정수 1이 나오는 구조라
        // 인코더 한 틱(짧은 tap)으론 값 자체가 안 쌓임. MOVE_Y()로 세기를 100까지 올려서
        // tick 1회 만에도 정수 이동량(1.6→1)이 나오게 함.

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            // NOTE(2026-08-22 감도 조정): 100→70. tick당 이동량 70*16/1000=1.12로, "정수 캐스팅에서
            // 0으로 버려지는" 최소선(62.5) 위 여유 두면서 세기는 낮춤. 더 낮추고 싶으면 62 밑으로는
            // 내려가지 말 것(다시 안 먹는 문제 재발).

            bindings = <&msc MOVE_Y(-70)>, <&msc MOVE_Y(70)>;

            tap-ms = <40>;
        };

        // NOTE(2026-09-05): Win 레이어 한/영 자리 전용 hold-tap.
        // stock &lt를 못 쓰는 이유: &lt의 탭 절반은 <&kp>라 키코드만 받는데, 여기선 탭에
        // 매크로(LANG1 + F24 두 개 송신)를 물려야 함. hold-tap은 tap 바인딩에 param2를
        // 그대로 넘길 뿐이고 zmk_behavior_invoke_binding이 #binding-cells를 검증하지
        // 않으므로(behavior.c:67), 0-cell 매크로를 물리고 더미 파라미터 0을 주면 됨.
        // flavor는 stock &lt(tap-preferred) 대신 &mt와 같은 hold-preferred.

        lt_hanyoung: lt_hanyoung {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&hanyoung_win>;
            display-name = "Layer-Tap 한영";
        };
    };

    // NOTE(2026-09-05): OS별 프로필 전환. `&bt BT_SEL n`은 현재 엔드포인트가 USB인지 확인하지
    // 않고 BLE 프로필 포인터만 바꾸므로(zmk_ble_prof_select), 유선 상태에서는 사실상 무시되고
    // `&to`만 실행됨 - 즉 유선/무선 구분 없이 같은 키로 레이어가 전환됨.
    // #binding-cells = <0> + display-name 이라 키맵에디터 키 목록에도 그대로 뜸.

    macros {
        prof_mac: prof_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Mac";
            bindings = <&bt BT_SEL 0 &to 0>;
        };

        prof_win: prof_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Win";
            bindings = <&bt BT_SEL 1 &to 1>;
        };

        // NOTE(2026-09-05): 윈도우 한/영 + Deskflow 경유 맥 한/영을 한 번에.
        // LANG1은 윈도우 IME를 바꾸고, F24는 Deskflow가 RegisterHotKey로 가로채서
        // 맥에 Alt+Space를 쏜다(config: keystroke(F24) = keyDown/keyUp(Alt+Space,hshomac)).
        // F24를 쓰는 이유: 핫키는 OS 전역 등록이라 트리거 키를 소비하는데, 안 쓰는 키를
        // 트리거로 삼으면 잃을 게 없다. 한/영 키를 직접 트리거로 걸면 윈도우 IME까지
        // 키가 안 가서 윈도우에서 한글을 못 치게 된다.
        // 부수 효과로 양쪽 OS의 IME 상태가 같이 뒤집혀 동기화가 유지된다.

        hanyoung_win: hanyoung_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "한영+F24";
            bindings = <&kp LANG1>, <&kp F24>;
        };

        prof_3: prof_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Prof3";
            bindings = <&bt BT_SEL 2 &to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // NOTE(2026-09-05): 레이어 번호 재배치. 윈도우 오버레이(구 6번)를 1번으로 내림.
        // ZMK는 "활성 레이어 중 인덱스가 가장 높은 것"이 이기므로(공식 문서 keymaps/index.mdx),
        // OS 오버레이를 최상위에 두면 그 레이어가 정의한 자리를 아래 momentary 레이어들이
        // 영영 못 씀. 공식 문서도 "베이스 레이어가 여러 개면 가능한 한 낮은 번호를 쓰라"고
        // 명시함. 그래서 Win=1로 내리고 나머지를 한 칸씩 밀었음.
        //   0=Mac  1=Win  2=Num  3=L3(예비)  4=Sym  5=Fn  6=Num_P

        default_layer {
            display-name = "Mac";

            // ------------------------------------------------------------------------------------------------
            // | Tab      | Q | W | X | E | T |               | Y | U | I  | O    | P     | Bkspc |
            // | CapsLock | A | S | D | F | G |               | H | J | K  | L    | \|\   | Enter |
            // | LShift   | Z | X | C | V | B | Mute | Mouse3 | N | M | ,  | .    | 키1(*) | 키2(**)|
            // | LGui | LAlt | LCtrl | MO(4) | MO(2) | Space | | Space | LT(3) | MO(5) | Left | Down | Right |
            // (*)  키1 = mod-morph, 탭=Up 화살표(원래 `/` 자리), 우쉬프트(키2 홀드)+탭=`?`
            // (**) 키2 = mod-tap(&mt), 탭=`/`, 홀드=RShift(원래 RShift 단독키였던 자리)
            // NOTE(2026-09-05): 좌하단 3개는 Cmd/Opt/Ctrl 순서 — 맥 정품(Ctrl/Opt/Cmd)이 아니라
            // 단축키 모디파이어(Cmd)를 윈도우의 Ctrl 자리(맨 왼쪽)로 맞춘 배열. Cmd+Opt 조합이
            // 붙어 있어서 ⌘⌥Esc/⌘⌥I 같은 맥 기본 조합도 손가락이 굴러감.
            // 우엄지 LT(3) = 탭이면 맥 한/영(Ctrl+Space), 홀드면 레이어3.
            // NOTE(2026-08-25): 오버레이 앱용 레이어 마커는 더 이상 커스텀 비헤이비어가 아니라
            // src/behavior_traceable_mo.c의 전역 이벤트 리스너(zmk_layer_state_changed 구독)가
            // 처리함 - 여기 bindings는 그냥 stock &mo 그대로라 키맵에디터에서도 정상 인식됨.

            bindings = <
&kp TAB    &kp Q     &kp W      &kp E  &kp R  &kp T                            &kp Y      &kp U            &kp I      &kp O     &kp P              &kp BSPC
&kp CAPS   &kp A     &kp S      &kp D  &kp F  &kp G                            &kp H      &kp J            &kp K      &kp L     &kp BSLH           &kp RET
&kp LSHFT  &kp Z     &kp X      &kp C  &kp V  &kp B      &kp C_MUTE  &mkp MB3  &kp N      &kp M            &kp COMMA  &kp DOT   &key1_arrow_qmark  &mt RSHFT FSLH
&kp LGUI   &kp LALT  &kp LCTRL  &mo 4  &mo 2  &kp SPACE                        &kp SPACE  &lt 3 LC(SPACE)  &mo 5      &kp LEFT  &kp DOWN           &kp RIGHT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&scroll_encoder>;
        };

        layer_1_win {
            display-name = "Win";

            // 윈도우 오버레이. `&prof_win`(레이어5 Fn)이 `&to 1`로 켜고, `&prof_mac`이 `&to 0`으로 끔.
            // Base 바로 위(가장 낮은 오버레이)라 위의 momentary 레이어들이 전부 이 레이어를 이김 -
            // 즉 Num/Sym/Fn/Num_P가 윈도우 상태에서도 그대로 다 동작함.
            // 좌하단 3개 = 윈도우 배열(Ctrl/Win/Alt), 우엄지 = 윈도우 한/영(LANG1).
            // 딥슬립(ZMK_SLEEP)을 안 켜뒀으므로 리셋 전까지 이 상태가 유지됨.

            bindings = <
&trans     &trans    &trans    &trans  &trans  &trans                  &trans  &trans       &trans  &trans  &trans  &trans
&trans     &trans    &trans    &trans  &trans  &trans                  &trans  &trans       &trans  &trans  &trans  &trans
&trans     &trans    &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans
&kp LCTRL  &kp LGUI  &kp LALT  &trans  &trans  &trans                  &trans  &lt_hanyoung 3 0  &trans  &trans  &trans  &trans
            >;
        };

        layer_2_num {
            display-name = "Num";

            // 실기기 Layer 1 — 상단열만 확인됨(Esc + 숫자), 나머지는 비어있어서 &trans
            // NOTE(2026-08-22 정정): 키캡 표기 `!1`은 "탭=1, 쉬프트+탭=!"라는 뜻인데 처음엔 반대로
            // 심볼(EXCL 등)을 탭 기본값으로 넣는 실수를 함 — 순수 숫자로 정정. 쉬프트는 그냥 눌리는 대로
            // 정상 작동하니 별도 처리 불필요(레이어랑 쉬프트는 서로 안 막음).
            // NOTE(2026-09-05): 하단열 Sym 자리에 &mo 6 — 수동 tri-layer. Num 잡고 옆(Sym) 자리를
            // 누르면 Num_P(넘패드). conditional_layers 대신 이렇게 한 이유는 키맵에디터가
            // `keymap` 노드 안만 읽어서, 특수 노드로 빼면 에디터에서 안 보이기 때문.

            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans     &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &mo 6   &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_3 {
            display-name = "L3";

            // 예비 레이어. 우엄지 LT(3) 홀드로 들어옴. 아직 내용 미정.

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans      &trans    &trans         &kp DELETE
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &kp INSERT  &kp HOME  &kp PAGE_UP    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DELETE  &kp END   &kp PAGE_DOWN  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans      &trans    &trans         &trans
            >;
        };

        layer_4_sym {
            display-name = "Sym";

            // NOTE(2026-09-05): 하단열 Num 자리에 &mo 6 — tri-layer 반대 방향(Sym 잡고 Num 누르기).

            bindings = <
&kp ESC  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp MINUS      &kp EQUAL  &trans
&trans   &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp LBKT       &kp RBKT   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SEMICOLON  &kp SQT    &trans
&trans   &trans  &trans  &trans  &mo 6   &trans                  &trans  &trans  &trans  &trans         &trans     &trans
            >;
        };

        layer_5_fn {
            display-name = "Fn";

            // 좌측 세로줄 = BT 초기화 + OS 프로필 매크로(macros 노드 참고).
            // 레이어 5라 윈도우 오버레이(1)보다 위에 있어서, 윈도우 상태에서도 하단열 자리가
            // 안 가려짐 - 어느 OS에서든 프로필 3개 다 누를 수 있음.

            bindings = <
&bt BT_CLR  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10  &kp DELETE
&prof_mac   &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp F11  &kp F12  &trans
&prof_win   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&prof_3  &trans  &trans  &trans  &trans  &trans                  &trans  &trans         &trans  &trans  &trans  &trans
            >;
        };

        layer_6_numpad {
            display-name = "Num_P";

            // Num + Sym 동시(수동 tri-layer)로 들어옴.

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N1  &kp N2  &kp N3
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp N0  &trans  &trans
            >;
        };
    };
};
