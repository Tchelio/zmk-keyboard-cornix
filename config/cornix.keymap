// NOTE(2026-08-22): 이전에 있던 urob 스타일 홈로우모드 커스텀 설정은 폐기하고, 실제 RMK로 쓰던
// 키보드를 그대로 이식한 상태로 새로 시작함. 원래 커스텀 파일은 backup/cornix.keymap.urob-homerowmods-20260822에,
// ZMK 저장소 자체 예시 기본값은 backup/cornix.keymap.zmk-community-stock-example에 보존해둠(참고용).
// 실측 근거: raw/keyboard/work/실측-RMK실제레이아웃-vial스크린샷-20260822.md (Vial 스크린샷 판독)
//
// 확인된 것만 이식함:
//   - Layer 0(Base): 실제 RMK 그대로. 유일하게 스톡과 다른 지점은 우측 하단열의 Up(원래 / 자리) — 의도적 커스텀.
//   - Layer 1: 상단열(Esc+숫자기호)만 확인됨, 나머지 행은 실기기에서 비어있어서 &trans로 둠.
//   - Layer 2 이상: 미확인(BT 프로필 선택 레이어로 추정되나 정확한 위치 불확실) — 아직 포함 안 함, 필요해지면 추가.
//   - 키2(슬래시, 홀드시 우쉬프트)는 아직 미구현 상태라 이식 대상 없음 — 나중에 별도 설계.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------
            // | Tab      | Q | W | X | E | T |               | Y | U | I  | O    | P     | Bkspc |
            // | CapsLock | A | S | D | F | G |               | H | J | K  | L    | \|\   | Enter |
            // | LShift   | Z | X | C | V | B | Mute | Mouse3 | N | M | ,  | .    | Up(*) | RShift|
            // | LCtrl | LGui | LAlt | MO(1) | MO(3) | Space | | Space | MO(4) | MO(2) | Left | Down | Right |
            // (*) 원래 `/` 자리 — 의도적으로 위쪽 화살표로 바꿔서 쓰는 중 (키1 설계, 키2는 별도 예정)

            bindings = <
&kp TAB    &kp Q     &kp W    &kp E    &kp R    &kp T                        &kp Y      &kp U    &kp I      &kp O    &kp P     &kp BSPC
&kp CAPS   &kp A     &kp S    &kp D    &kp F    &kp G                        &kp H      &kp J    &kp K      &kp L    &kp BSLH  &kp RET
&kp LSHFT  &kp Z     &kp X    &kp C    &kp V    &kp B      &kp C_MUTE &mkp MB3  &kp N   &kp M    &kp COMMA  &kp DOT  &kp UP    &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT &mo 1    &mo 3    &kp SPACE               &kp SPACE  &mo 4  &mo 2     &kp LEFT  &kp DOWN  &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "Numbers";

            // 실기기 Layer 1 — 상단열만 확인됨(Esc + 숫자/기호), 나머지는 비어있어서 &trans

            bindings = <
&kp ESC   &kp EXCL  &kp AT   &kp HASH  &kp DLLR  &kp PRCNT                    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
&trans    &trans    &trans   &trans    &trans    &trans                       &trans     &trans    &trans     &trans    &trans    &trans
&trans    &trans    &trans   &trans    &trans    &trans     &trans    &trans  &trans     &trans    &trans     &trans    &trans    &trans
&trans    &trans    &trans   &trans    &trans    &trans                       &trans     &trans    &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
