// NOTE(2026-08-22): 이전에 있던 urob 스타일 홈로우모드 커스텀 설정은 폐기하고, 실제 RMK로 쓰던
// 키보드를 그대로 이식한 상태로 새로 시작함. 원래 커스텀 파일은 backup/cornix.keymap.urob-homerowmods-20260822에,
// ZMK 저장소 자체 예시 기본값은 backup/cornix.keymap.zmk-community-stock-example에 보존해둠(참고용).
// 실측 근거: raw/keyboard/work/실측-RMK실제레이아웃-vial스크린샷-20260822.md (Vial 스크린샷 판독)
//
// 확인된 것만 이식함:
//   - Layer 0(Base): 실제 RMK 그대로. 유일하게 스톡과 다른 지점은 우측 하단열의 Up(원래 / 자리) — 의도적 커스텀.
//   - Layer 1: 상단열(Esc+숫자기호)만 확인됨, 나머지 행은 실기기에서 비어있어서 &trans로 둠.
//   - Layer 2/3/4: BT 프로필 선택(공장 기본값, 사용자 확인함) — 왼손 상단열에 BT_SEL 0/1/2, 나머지 &trans.
//   - 키1(화살표/물음표): mod-morph로 구현 — 아래 behaviors 참고.
//   - 키2(슬래시/우쉬프트): 우하단 팜 Right(화살표) 바로 위, 원래 RShift였던 자리를 mod-tap으로 재활용 —
//     탭=`/`, 홀드=RSFT. ZMK 내장 &mt 그대로 사용(커스텀 behavior 불필요).

#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // 키1: 탭=Up(화살표), 우쉬프트(키2 홀드)+탭='?', 좌쉬프트+탭=조건 불일치라 그냥 Shift+Up 통과(드래그/선택)
        // NOTE(2026-08-22 정정): 처음엔 좌쉬프트를 '?' 트리거로 넣었으나 실사용해보니 반대였음 — 우쉬프트로 수정.

        key1_arrow_qmark: key1_arrow_qmark {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&kp QUESTION>;

            mods = <(MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------
            // | Tab      | Q | W | X | E | T |               | Y | U | I  | O    | P     | Bkspc |
            // | CapsLock | A | S | D | F | G |               | H | J | K  | L    | \|\   | Enter |
            // | LShift   | Z | X | C | V | B | Mute | Mouse3 | N | M | ,  | .    | 키1(*) | 키2(**)|
            // | LCtrl | LGui | LAlt | MO(1) | MO(3) | Space | | Space | MO(4) | MO(2) | Left | Down | Right |
            // (*)  키1 = mod-morph, 탭=Up 화살표(원래 `/` 자리), 우쉬프트(키2 홀드)+탭=`?`
            // (**) 키2 = mod-tap(&mt), 탭=`/`, 홀드=RShift(원래 RShift 단독키였던 자리)

            bindings = <
&kp TAB    &kp Q     &kp W     &kp E  &kp R  &kp T                            &kp Y      &kp U  &kp I      &kp O     &kp P              &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D  &kp F  &kp G                            &kp H      &kp J  &kp K      &kp L     &kp BSLH           &kp RET
&kp LSHFT  &kp Z     &kp X     &kp C  &kp V  &kp B      &kp C_MUTE  &mkp MB3  &kp N      &kp M  &kp COMMA  &kp DOT   &key1_arrow_qmark  &mt RSHFT FSLH
&kp LCTRL  &kp LGUI  &kp LALT  &mo 1  &mo 3  &kp SPACE                        &kp SPACE  &mo 4  &mo 2      &kp LEFT  &kp DOWN           &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "Numbers";

            // 실기기 Layer 1 — 상단열만 확인됨(Esc + 숫자), 나머지는 비어있어서 &trans
            // NOTE(2026-08-22 정정): 키캡 표기 `!1`은 "탭=1, 쉬프트+탭=!"라는 뜻인데 처음엔 반대로
            // 심볼(EXCL 등)을 탭 기본값으로 넣는 실수를 함 — 순수 숫자로 정정. 쉬프트는 그냥 눌리는 대로
            // 정상 작동하니 별도 처리 불필요(레이어랑 쉬프트는 서로 안 막음).

            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DEL
&trans   &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // NOTE(2026-08-22 정정): 처음엔 BT_SEL 0/1/2를 레이어2/3/4에 한 줄씩 흩어서 넣는 걸로 추론했으나
        // 실사용 확인 결과 틀림 — 레이어2/3은 내용이 동일하고, BT_SEL 0/1/2는 좌하단(팜 자리)에 세로로
        // 같이 모여있음. 레이어4는 사실상 빈 레이어(Mute/Mouse3는 &trans로 Base에서 자동 상속).

        bt_layer_2 {
            display-name = "BT2";
            bindings = <
&trans        &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        bt_layer_3 {
            display-name = "BT3";
            bindings = <
&trans        &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        bt_layer_4 {
            display-name = "BT4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
